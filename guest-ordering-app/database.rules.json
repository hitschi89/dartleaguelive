{
  "rules": {
    "orders": {
      ".read": true,
      ".write": true,
      "$orderId": {
        ".validate": "newData.hasChildren(['createdAt', 'status'])",
        "status": {
          ".validate": "newData.isString() && (newData.val() === 'offen' || newData.val() === 'fertig')"
        }
      }
    },
    "$other": {
      ".validate": false
    }
  }
}
